{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brailled edit command",
  "description": "One edit to the selected sprite or stage, or a request to undo, redo or describe.",
  "$comment": "Blocks are named by opcode and values by input or field name, so blocks from extensions need no change to this format. See 'Extension blocks' in the package README.",
  "oneOf": [
    {"$ref": "#/$defs/insert"},
    {"$ref": "#/$defs/delete"},
    {"$ref": "#/$defs/set-value"},
    {"$ref": "#/$defs/move"},
    {"$ref": "#/$defs/wrap"},
    {"$ref": "#/$defs/create"},
    {"$ref": "#/$defs/rename"},
    {"$ref": "#/$defs/undo"},
    {"$ref": "#/$defs/redo"},
    {"$ref": "#/$defs/describe"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "description": "A block id."},
    "opcode": {"type": "string", "minLength": 1, "description": "A block opcode, such as motion_movesteps."},
    "value": {
      "description": "Text or a number for a slot, a block to put in it, or null to empty it.",
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "null"},
        {"$ref": "#/$defs/nested"}
      ]
    },
    "nested": {
      "type": "object",
      "required": ["block"],
      "additionalProperties": false,
      "properties": {"block": {"$ref": "#/$defs/opcode"}, "args": {"$ref": "#/$defs/args"}}
    },
    "args": {
      "type": "object",
      "description": "Values by input or field name.",
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "inside": {
      "type": "object",
      "description": "The start of a stack held by a loop or condition.",
      "required": ["block"],
      "additionalProperties": false,
      "properties": {
        "block": {"$ref": "#/$defs/id"},
        "branch": {"type": "string", "pattern": "^SUBSTACK[0-9]*$", "description": "Such as SUBSTACK2."}
      }
    },
    "insert": {
      "type": "object",
      "description": "Add a block after, before or inside another. With none of these it starts a new script.",
      "required": ["op", "block"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "insert"},
        "block": {"$ref": "#/$defs/opcode"},
        "after": {"$ref": "#/$defs/id"},
        "before": {"$ref": "#/$defs/id"},
        "inside": {"$ref": "#/$defs/inside"},
        "args": {"$ref": "#/$defs/args"}
      }
    },
    "delete": {
      "type": "object",
      "description": "Delete a block and what it holds; with withFollowing, the blocks under it as well.",
      "required": ["op", "block"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "delete"},
        "block": {"$ref": "#/$defs/id"},
        "withFollowing": {"type": "boolean"}
      }
    },
    "set-value": {
      "type": "object",
      "description": "Change one value of a block.",
      "required": ["op", "block", "name", "value"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "set-value"},
        "block": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "description": "Input or field name, such as STEPS."},
        "value": {"$ref": "#/$defs/value"}
      }
    },
    "move": {
      "type": "object",
      "description": "Move a block to one of after, before, inside or newScript.",
      "required": ["op", "block"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "move"},
        "block": {"$ref": "#/$defs/id"},
        "after": {"$ref": "#/$defs/id"},
        "before": {"$ref": "#/$defs/id"},
        "inside": {"$ref": "#/$defs/inside"},
        "newScript": {"const": true},
        "withFollowing": {"type": "boolean"}
      }
    },
    "wrap": {
      "type": "object",
      "description": "Put a block, or the run of blocks from it to through, inside a loop or condition.",
      "required": ["op", "block", "in"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "wrap"},
        "block": {"$ref": "#/$defs/id"},
        "through": {"$ref": "#/$defs/id"},
        "in": {"$ref": "#/$defs/opcode", "description": "A loop or condition, such as control_repeat."},
        "args": {"$ref": "#/$defs/args"}
      }
    },
    "kind": {"enum": ["variable", "list", "message"], "description": "A message is a broadcast message."},
    "create": {
      "type": "object",
      "description": "Make a variable, list or broadcast message. Scope is for all sprites unless given.",
      "required": ["op", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "create"},
        "kind": {"$ref": "#/$defs/kind"},
        "name": {"type": "string"},
        "scope": {"enum": ["all", "sprite"]}
      }
    },
    "rename": {
      "type": "object",
      "description": "Rename a variable, list or broadcast message that the selected sprite can use.",
      "required": ["op", "kind", "name", "to"],
      "additionalProperties": false,
      "properties": {
        "op": {"const": "rename"},
        "kind": {"$ref": "#/$defs/kind"},
        "name": {"type": "string", "description": "The present name."},
        "to": {"type": "string", "description": "The new name."}
      }
    },
    "undo": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {"op": {"const": "undo"}}
    },
    "redo": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {"op": {"const": "redo"}}
    },
    "describe": {
      "type": "object",
      "description": "Read the whole program, or the script containing a block, as one summary.",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {"op": {"const": "describe"}, "script": {"$ref": "#/$defs/id"}}
    }
  }
}
