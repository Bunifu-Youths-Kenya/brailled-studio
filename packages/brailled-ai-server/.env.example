# Copy to .env, which is never committed, and fill in the first two.

# Your OpenRouter API key. It stays on this server.
OPENROUTER_API_KEY=
# The model to ask, as OpenRouter names it, for example vendor/model-name.
OPENROUTER_MODEL=

# Use only providers that neither store nor train on what is sent. "false" allows any provider.
OPENROUTER_DENY_DATA_COLLECTION=true
# Use only endpoints with zero data retention. Not every model has one.
OPENROUTER_ZERO_DATA_RETENTION=true
# Which of the providers that fit are tried first: latency (the quickest), throughput, price, or off.
OPENROUTER_PROVIDER_SORT=latency

# The port to listen on. The server accepts connections from this computer only.
PORT=8787
# Addresses of editors allowed to call it, separated by commas.
ALLOWED_ORIGINS=http://localhost:8601
# How many proxies are in front of this server, so that each visitor's own address is limited.
TRUSTED_PROXIES=0

# Requests allowed in a minute from one address (a school may share one), and from everyone together.
REQUESTS_PER_MINUTE_PER_ADDRESS=30
REQUESTS_PER_MINUTE=120
# Requests allowed in a day from everyone together, to bound the cost.
REQUESTS_PER_DAY=2000
# Largest request body, in bytes.
MAX_REQUEST_BYTES=131072
# How long to wait for one call to the model, in milliseconds.
UPSTREAM_TIMEOUT_MS=30000
# The model may look things up before it answers. This is the most calls it gets for one request, up to 10, so one
# request can cost that many calls.
AI_MAX_ROUNDS=6
# How long one request may take altogether. The editor gives up after 45 seconds.
AI_TURN_TIMEOUT_MS=40000

# Voice conversation (the editor's "gemini-pair" and "openai-audio" providers). It uses the key above.
# The models the editor may ask for to hear and speak, separated by commas. Empty means the usual ones: see the
# README.
AI_AUDIO_MODELS=
# The longest recording taken, in seconds.
AI_MAX_AUDIO_SECONDS=60
# Voice requests allowed in a minute from one address.
VOICE_REQUESTS_PER_MINUTE_PER_ADDRESS=20
# Voice requests allowed in a day. Leave empty for the editor's "dailyRequestCap" (300). The lower of the two counts.
VOICE_REQUESTS_PER_DAY=
# Pieces read aloud in a minute from one address: a reply is read a sentence at a time.
SPEAK_REQUESTS_PER_MINUTE_PER_ADDRESS=90
# Characters read aloud in a day. Leave empty for the editor's "dailyCharacterCap" (50000). The lower of the two counts.
VOICE_CHARACTERS_PER_DAY=

# The most the AI calls may cost in a day, in US dollars, by this server's estimate. 0 refuses everything.
AI_DAILY_COST_CAP_USD=1
# Where the record of costs is kept: by default logs/cost.jsonl beside this file. "off" keeps none.
AI_COST_LOG=
